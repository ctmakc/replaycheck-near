# `npm run setup:testnet` writes a complete .env.near for you. This file documents the variables.

NEAR_NETWORK=testnet                 # testnet | mainnet
# NEAR_RPC=https://rpc.testnet.near.org

# Market contract (escrow jobs + pay-with-memo), deployed by scripts/near-setup.mjs
REPLAYCHECK_CONTRACT_ID=market.rc-xxxxxx.testnet

# The ReplayCheck agent: sells runs, pays the worker. Its own key, never a personal wallet.
REPLAYCHECK_AGENT_ID=agent.rc-xxxxxx.testnet
REPLAYCHECK_AGENT_KEY=ed25519:...

# The browser worker: a second agent that sells browser minutes and judgement calls.
REPLAYCHECK_WORKER_ID=worker.rc-xxxxxx.testnet
REPLAYCHECK_WORKER_URL=http://127.0.0.1:8745
WORKER_PORT=8745
WORKER_PRICE_PER_MINUTE=0.001        # NEAR
WORKER_PRICE_JUDGE=0.002             # NEAR
OLLAMA_URL=http://127.0.0.1:11434    # judgement model host (optional; judge checks fail without it)
OLLAMA_MODEL=qwen2.5:7b-instruct
# REPLAYCHECK_CHROME=/path/to/chromium  # only if Playwright's own Chromium is not installed

# Demo customer used by the live page and `replaycheck order` (testnet only)
REPLAYCHECK_DEMO_CUSTOMER_ID=buyer.rc-xxxxxx.testnet
REPLAYCHECK_DEMO_CUSTOMER_KEY=ed25519:...

# Agent service
PORT=8744
REPLAYCHECK_PUBLIC_BASE=http://127.0.0.1:8744
REPLAYCHECK_DEMO_PER_HOUR=20

# Spending guards for the agent (yoctoNEAR): per paid call and per process
REPLAYCHECK_MAX_CALL_YOCTO=10000000000000000000000      # 0.01 NEAR
REPLAYCHECK_MAX_RUN_YOCTO=500000000000000000000000      # 0.5 NEAR
