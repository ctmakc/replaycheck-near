{
  "name": "replaycheck",
  "version": "0.1.0",
  "description": "Replays your users' key flows in rented browsers and settles every step on NEAR: customers escrow jobs on a market contract, the agent pays a browser worker over HTTP 402 (near402).",
  "type": "module",
  "bin": {
    "replaycheck": "bin/replaycheck.js"
  },
  "scripts": {
    "whoami": "node bin/replaycheck.js whoami",
    "demo": "node bin/replaycheck.js order tasks/demo.json",
    "serve": "node src/server.js",
    "setup:testnet": "node scripts/near-setup.mjs",
    "worker": "node worker/server.js",
    "test": "node --test test/*.test.js",
    "contract:build": "bash scripts/build-contract.sh",
    "contract:test": "cd contracts/replay-market && cargo test",
    "run:local": "node bin/replaycheck.js run tasks/demo.json"
  },
  "engines": {
    "node": ">=22"
  },
  "license": "MIT",
  "dependencies": {
    "near-api-js": "^7.4.0",
    "playwright": "^1.58.0"
  }
}
